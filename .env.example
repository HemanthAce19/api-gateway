# Copy to .env and change. JWT_SECRET must be at least 32 characters.
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
REDIS_URL=redis://localhost:6379/0
ROUTES_FILE=routes.yaml
DEMO_UPSTREAM=http://localhost:9000
DEMO_MODE=true
RATE_LIMIT_FAIL_MODE=open
UPSTREAM_TIMEOUT=5
# Optional per-plan overrides (plans: ANONYMOUS, FREE, PRO)
# RL_FREE_CAPACITY=10
# RL_FREE_PER_MINUTE=10
